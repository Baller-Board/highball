# Copy to .env.local and fill in from your Supabase project:
# Supabase dashboard -> Project Settings -> API Keys (and Data API for the URL)
# The key is the "Publishable key" (sb_publishable_...) or, on older projects, the "anon public" key.
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
